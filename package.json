{
  "name": "priora-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm --prefix backend run dev",
    "serve": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
